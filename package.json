{
  "name": "perk-done",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "package": "npm run build && node scripts/package.mjs",
    "test:browser": "node scripts/verify-browser.mjs",
    "format": "prettier --write src tests scripts public/manifest.json index.html vite.config.ts tsconfig.json"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/chrome": "^0.0.302",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
